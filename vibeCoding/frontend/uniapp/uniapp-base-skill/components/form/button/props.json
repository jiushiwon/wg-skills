{
  "name": "button",
  "title": "按钮",
  "category": "form",
  "description": "统一按钮样式：primary / ghost / text / danger × sm / md / lg，支持 loading / disabled / block / round",
  "aliases": ["按钮", "button", "提交按钮", "主按钮", "次按钮"],
  "props": [
    { "name": "type", "type": "'primary' | 'ghost' | 'text' | 'danger'", "default": "primary", "desc": "按钮类型" },
    { "name": "size", "type": "'sm' | 'md' | 'lg'", "default": "md", "desc": "尺寸" },
    { "name": "disabled", "type": "boolean", "default": false, "desc": "禁用" },
    { "name": "loading", "type": "boolean", "default": false, "desc": "加载中（内置转圈并禁用点击）" },
    { "name": "block", "type": "boolean", "default": false, "desc": "块级，宽度 100%" },
    { "name": "shape", "type": "'radius' | 'round'", "default": "radius", "desc": "圆角风格" },
    { "name": "icon", "type": "string", "default": "", "desc": "左侧图标地址" },
    { "name": "text", "type": "string", "default": "按钮", "desc": "按钮文字，默认插槽优先" }
  ],
  "events": ["click"],
  "slots": [{ "name": "default", "desc": "按钮内容，优先于 text" }]
}
